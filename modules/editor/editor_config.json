{
    "logger": {
        "file": "CSEditor.log",
        "sinks": [
            "console",
            "file"
        ],
        "levels": [
            "debug",
            "info",
            "performance",
            "warning",
            "error",
            "fatal"
        ],
        "showPid": false,
        "showTid": false,
        "//maxFileSize": "10MB",
        "maxFileSize": 10
    }
}